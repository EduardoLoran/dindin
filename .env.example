NODE_ENV=production
HOST=127.0.0.1
PORT=3030
DB_FILE=/var/lib/dindin/gastos.sqlite
PUBLIC_URL=https://dindin-custos.com.br
ALLOWED_ORIGINS=https://dindin-custos.com.br,https://www.dindin-custos.com.br,https://dindin.vps-kinghost.net,https://www.dindin.vps-kinghost.net
TRUST_PROXY=true

SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=86400
JSON_BODY_LIMIT_BYTES=524288
OFX_FILE_LIMIT_BYTES=5242880
OFX_MAX_TRANSACTIONS=5000

TURNSTILE_REQUIRED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTS=dindin-custos.com.br,www.dindin-custos.com.br,dindin.vps-kinghost.net,www.dindin.vps-kinghost.net

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Usadas somente quando o banco ainda nao possui usuarios.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_DISPLAY_NAME=Administrador
INITIAL_ADMIN_PASSWORD=
